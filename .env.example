# Copy to .env at the repository root. Never commit the filled file.
COMPOSE_PROJECT_NAME=car-manual-rag
POSTGRES_USER=rag
POSTGRES_DB=rag
# Use a long random hexadecimal password (URL-safe for DATABASE_URL).
POSTGRES_PASSWORD=
# At least 32 random bytes; generate with python -c "import secrets; print(secrets.token_hex(32))".
JWT_SECRET=
DEEPSEEK_API_KEY=

